# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your real values.
# DO NOT commit .env.local — it contains secrets.
# ─────────────────────────────────────────────────────────────

# Supabase — member area (lessons, auth, progress)
# Create a project at https://supabase.com, run `supabase/migrations/*.sql` and `supabase/seed.sql` in the SQL editor.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# Optional: only for local scripts; never expose in the browser
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Stripe — required
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PRICE_ID=price_your_price_id_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Public site URL (Stripe success/cancel + Supabase auth redirects / password recovery)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — transactional email
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=CYT Course <hello@cytcourse.com>
RESEND_REPLY_TO=support@cytcourse.com
SUPPORT_EMAIL=support@cytcourse.com

# Optional logo (absolute URL) shown in the post-purchase email
# NEXT_PUBLIC_LOGO_URL=https://cytcourse.com/images/logo.png

# ─────────────────────────────────────────────────────────────
# In production (Vercel), set the same variables in
# Project → Settings → Environment Variables.
# Use sk_live_… and the production webhook signing secret.
# ─────────────────────────────────────────────────────────────
